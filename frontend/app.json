{
  "expo": {
    "name": "Siddhnath Dairy",
    "slug": "siddhnath-dairy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "siddhnath",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan milk machine display for instant rate calculation",
        "NSPhotoLibraryUsageDescription": "Pick machine photo to read Fat/SNF values"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2D6A35"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan milk machine display for instant rate calculation"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick machine photo to read Fat/SNF values"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
